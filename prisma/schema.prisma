// Prisma Schema — Boutique de Pommades Cosmétiques

generator client {
  provider = "prisma-client"
  output   = "../../node_modules/.prisma/client/default"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Float
  images      String      // JSON array of image URLs
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  stock       Int         @default(0)
  ingredients String?
  instructions String?
  benefits    String?
  status      String      @default("active") // active | inactive
  featured    Boolean     @default(false)
  avgRating   Float       @default(0)
  reviewCount Int         @default(0)
  orderItems  OrderItem[]
  reviews     Review[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Customer {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  addresses    String    @default("[]") // JSON array of addresses
  orders       Order[]
  reviews      Review[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  guestEmail    String?
  guestName     String?
  items         OrderItem[]
  address       String      // JSON object
  status        String      @default("pending") // pending | processing | shipped | delivered | cancelled
  subtotal      Float
  shippingCost  Float       @default(0)
  taxAmount     Float       @default(0)
  total         Float
  promoCodeId   String?
  promoCode     PromoCode?  @relation(fields: [promoCodeId], references: [id])
  promoDiscount Float       @default(0)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
}

model PromoCode {
  id         String   @id @default(cuid())
  code       String   @unique
  type       String   // percentage | fixed
  value      Float
  startDate  DateTime?
  endDate    DateTime?
  maxUses    Int?
  currentUses Int     @default(0)
  minPurchase Float   @default(0)
  active     Boolean  @default(true)
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  authorName String
  rating     Int      // 1-5
  comment    String?
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // admin | superadmin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StoreSettings {
  id           String  @id @default(cuid())
  key          String  @unique
  value        String
}
